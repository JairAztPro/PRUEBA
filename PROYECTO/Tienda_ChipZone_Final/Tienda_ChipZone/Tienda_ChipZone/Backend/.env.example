DB_USER=techlab_app
DB_PASSWORD=reemplazar_con_una_clave_local
MYSQL_ROOT_PASSWORD=reemplazar_con_otra_clave_local
# Semana 14 (solo perfil "lab"): cuentas de laboratorio. Claves de 12 a 72 bytes, solo para este equipo.
TECHLAB_ADMIN_USER=admin
TECHLAB_ADMIN_PASSWORD=reemplazar_con_clave_local_admin
TECHLAB_STUDENT_USER=estudiante
TECHLAB_STUDENT_PASSWORD=reemplazar_con_clave_local_estudiante
# Semana 15: clave HS256 en Base64 (minimo 32 bytes). Generar con: openssl rand -base64 32
TECHLAB_JWT_SECRET_B64=reemplazar_con_clave_base64_generada_localmente
